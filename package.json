{
  "name": "info-bisericabetel",
  "private": true,
  "version": "1.1.0",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @betel/app dev",
    "dev:api": "pnpm --filter @betel/api dev",
    "dev:db": "docker compose up -d --wait db",
    "seed:dev": "scripts/seed-from-live.sh dev",
    "staging:up": "docker compose -f docker-compose.staging.yml up -d --build --wait",
    "staging:down": "docker compose -f docker-compose.staging.yml down",
    "staging:logs": "docker compose -f docker-compose.staging.yml logs -f app",
    "seed:staging": "scripts/seed-from-live.sh staging",
    "build": "pnpm --filter @betel/app build",
    "build:api": "pnpm --filter @betel/api build",
    "build:all": "pnpm -r build",
    "test": "cypress run",
    "test:open": "cypress open",
    "test:unit": "pnpm --filter @betel/shared --filter @betel/api test",
    "lint": "pnpm -r lint",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.0",
    "cypress": "^13.17.0",
    "release-it": "^20.0.1",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress",
      "esbuild",
      "sharp"
    ]
  }
}
