# syntax=docker/dockerfile:1
# CapRover app: betel-frontend (or whatever the frontend app is named in CapRover)
#
# Required CapRover env var:
#   API_HOST — Docker Swarm service name of the API app, e.g. srv-captain--betel-api

# ─── Stage 1: base ─────────────────────────────────────────────────────────────
FROM node:24-slim AS base
RUN npm install -g pnpm@10

# ─── Stage 2: deps ─────────────────────────────────────────────────────────────
FROM base AS deps
WORKDIR /app

# All workspace manifests are needed for pnpm to resolve the workspace graph.
# Only pwa/admin and their transitive deps (shared) will be installed via --filter.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/api/package.json    ./packages/api/
COPY packages/app/package.json    ./packages/app/

RUN pnpm install --frozen-lockfile --filter @betel/app...

# ─── Stage 3: builder ──────────────────────────────────────────────────────────
FROM deps AS builder
COPY packages/shared ./packages/shared
COPY packages/app    ./packages/app

RUN pnpm --filter @betel/app build

# ─── Stage 4: nginx ────────────────────────────────────────────────────────────
# nginx.conf uses ${API_HOST} — the image runs envsubst on *.template files at startup.
# Set API_HOST to the Docker Swarm service name of the API app in CapRover env vars,
# e.g. srv-captain--betel-api
FROM nginx:alpine

COPY nginx/nginx.conf /etc/nginx/templates/default.conf.template

# App static files → served at /  (public hub at /, admin at /admin/)
COPY --from=builder /app/packages/app/dist /var/www/app
