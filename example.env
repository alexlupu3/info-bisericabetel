# ─── API Server ───────────────────────────────────────────────────────────────
PORT=3100
HOST=127.0.0.1

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection URL (required — the server will crash without it)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://info-bisericabetel-api:<password>@<host>:5432/info_bisericabetel

# ─── Authentication ───────────────────────────────────────────────────────────
# Secret used to sign JWT tokens (min 32 chars recommended)
JWT_SECRET=change-me-to-a-strong-random-secret

# ─── File Storage ─────────────────────────────────────────────────────────────
# Absolute path where uploaded images (WebP) are stored
# Defaults to: <cwd>/../uploads  when not set
UPLOADS_DIR=/absolute/path/to/uploads

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Required when admin email notifications are implemented (FR-030, FR-031).
# Obtain an API key from https://resend.com — free tier covers 3 000 emails/month.
# One-time DNS setup required: add SPF and DKIM records for info.bisericabetel.ro.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@info.bisericabetel.ro

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Allowed CORS origin for the API
CORS_ORIGIN=https://your-domain.example.com
# Set to true only in development to allow running the seed script
SEED_ALLOWED=false
