# ─── info.bisericabetel — environment template ───────────────────────────────
#
#   cp example.env .env
#
# The root .env is read by:
#   - `pnpm dev:api` and `pnpm --filter @betel/api seed-admin` (via dotenv-cli)
#   - `docker compose` (variable substitution in docker-compose.yml)
#
# Full reference (every variable, default, and where it is read):
#   docs/architecture/configuration.md
#
# Optional keys are commented out on purpose: an empty `KEY=` line is still
# "set", so leave a key commented unless you give it a value.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Required ─────────────────────────────────────────────────────────────────
# Signs admin JWTs. Use a random string of at least 32 characters,
# e.g. `openssl rand -base64 48`.
JWT_SECRET=

# Password for the bundled `db` service in docker-compose.yml.
DB_PASSWORD=

# PostgreSQL connection string used by `pnpm dev:api` and `seed-admin`.
# Matches the bundled `db` service started with `docker compose up -d db`
# (replace <DB_PASSWORD> with the value above).
# Ignored by `docker compose up` — the containerised app always talks to `db`.
DATABASE_URL=postgresql://betel:<DB_PASSWORD>@localhost:5432/info_bisericabetel

# ─── Optional: API server (local dev) ─────────────────────────────────────────
# PORT=3100
# HOST=0.0.0.0
# Defaults to ../uploads relative to the API working directory
# (packages/uploads when started with `pnpm dev:api`).
# UPLOADS_DIR=

# ─── Optional: features ───────────────────────────────────────────────────────
# Enables AI auto-translation of content and groups (OpenRouter).
# OPEN_ROUTER_API_KEY=
# Enables the remote MCP endpoint at /mcp (Bearer token). Long random string.
# MCP_SECRET=

# ─── Optional: docker compose only ────────────────────────────────────────────
# Host port for the app container (container listens on 80).
# APP_HOST_PORT=8080
# Host port for the bundled PostgreSQL (bound to 127.0.0.1 only).
# DB_HOST_PORT=5432
