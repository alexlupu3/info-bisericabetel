# ─── info.bisericabetel — environment template ───────────────────────────────
#
#   cp example.env .env
#
# The root .env is read by:
#   - `pnpm dev:api` and `pnpm --filter @betel/api seed-admin` (via dotenv-cli)
#   - `docker compose` (variable substitution in docker-compose.yml and docker-compose.staging.yml)
#   - `scripts/seed-from-live.sh`
#
# Full reference (every variable, default, and where it is read):
#   docs/architecture/configuration.md
#
# Optional keys are commented out on purpose: an empty `KEY=` line is still
# "set", so leave a key commented unless you give it a value.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Required ─────────────────────────────────────────────────────────────────
# Signs admin JWTs. Use a random string of at least 32 characters,
# e.g. `openssl rand -base64 48`.
JWT_SECRET=

# Password for the dev database (docker-compose.yml) and the local staging database.
# Must be URL-safe (no # @ / : ? %): it is inserted unescaped into DATABASE_URL.
# Generate one with: openssl rand -hex 24
DB_PASSWORD=

# PostgreSQL connection string used by `pnpm dev:api` and `seed-admin`.
# Matches the dev database started with `pnpm dev:db`
# (replace <DB_PASSWORD> with the value above).
# Not used by docker-compose.staging.yml — the staging app talks to its own `db`.
DATABASE_URL=postgresql://betel:<DB_PASSWORD>@localhost:5432/info_bisericabetel

# Public origin of the hub (no path, no trailing slash): canonical URLs, Open
# Graph, JSON-LD, sitemap.xml, robots.txt. Required in production — the API
# refuses to start without it (set it in CapRover). Leave it unset locally:
# `pnpm dev:api` falls back to http://localhost:3100 (with a warning) and
# local staging to http://localhost:${STAGING_APP_PORT:-8080} (see STAGING_PUBLIC_BASE_URL).
# PUBLIC_BASE_URL=https://info.bisericabetel.com

# ─── Optional: API server (local dev) ─────────────────────────────────────────
# PORT=3100
# HOST=0.0.0.0
# Defaults to ../uploads relative to the API working directory
# (packages/uploads when started with `pnpm dev:api`).
# UPLOADS_DIR=

# ─── Optional: features ───────────────────────────────────────────────────────
# Enables AI auto-translation of content and groups (OpenRouter).
# OPEN_ROUTER_API_KEY=
# Enables the remote MCP endpoint at /mcp (Bearer token). Long random string.
# MCP_SECRET=

# ─── Optional: SEO (defaults in docs/architecture/configuration.md) ───────────
# SEO_ORG_NAME=Biserica Baptistă Betel
# SEO_SITE_NAME=Betel Info
# SEO_SITE_ALTERNATE_NAMES=Info Biserica Betel
# SEO_ORG_WEBSITE=https://www.bisericabetel.com
# SEO_ORG_SAME_AS=
# SEO_ORG_LOGO_PATH=/icons/icon-512.png
# SEO_DEFAULT_COUNTRY=RO
# GOOGLE_SITE_VERIFICATION=
# SEO_CACHE_TTL_SECONDS=60

# ─── Optional: dev database (docker-compose.yml) ──────────────────────────────
# Host port for the dev PostgreSQL (bound to 127.0.0.1 only).
# DB_HOST_PORT=5432

# ─── Optional: local staging (docker-compose.staging.yml) ─────────────────────
# Reuses DB_PASSWORD and JWT_SECRET. Production feature keys are not inherited.
# STAGING_APP_PORT=8080
# STAGING_DB_PORT=5433
# STAGING_JWT_SECRET=
# STAGING_OPEN_ROUTER_API_KEY=
# STAGING_MCP_SECRET=
# Defaults to http://localhost:<STAGING_APP_PORT>; .env's PUBLIC_BASE_URL is not inherited.
# STAGING_PUBLIC_BASE_URL=

# ─── Optional: seeding from live (scripts/seed-from-live.sh) ──────────────────
# Set one of these. LIVE_SSH also copies uploaded media.
# LIVE_SSH=root@your-caprover-host
# LIVE_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/postgres
# Defaults match the CapRover service names and the one-click Postgres app.
# LIVE_DB_SERVICE=srv-captain--info-bisericabetel-db
# LIVE_APP_SERVICE=srv-captain--info-bisericabetel
# LIVE_DB_USER=postgres
# LIVE_DB_NAME=postgres
