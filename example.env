# ─── API Server ───────────────────────────────────────────────────────────────
PORT=
HOST=

# ─── Database (live) ──────────────────────────────────────────────────────────
# NOTE: provide DATABASE_URL to connect to a remote DB. Leave empty for docker.
# DATABASE_URL=
DB_PASSWORD=

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOADS_DIR=

# ─── AI Translations ──────────────────────────────────────────────────────────
# Optional: enables automatic Claude-powered translation on content/group create & update
ANTHROPIC_API_KEY=

# ─── Other ────────────────────────────────────────────────────────────────────
NODE_ENV=
CORS_ORIGIN=
SEED_ALLOWED=
