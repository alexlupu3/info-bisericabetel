node_modules/
dist/
.env
.env.local
.env.*
!example.env

# Live dumps and upload archives pulled by scripts/seed-from-live.sh
.local/
*.local
cypress/videos/
cypress/screenshots/
cypress/downloads/
.DS_Store
*.pem

# Local-only helper scripts (may contain server-specific topology).
# Only explicitly whitelisted scripts are tracked.
scripts/*
!scripts/generate-icons.mjs
!scripts/seed-from-live.sh
!scripts/seed-from-public.mjs

# Agent memory (internal tooling state)
.claude/agent-memory/

# Database dumps and ad-hoc backups
*.dump
*.sql
# Keep migration SQL
!packages/api/src/db/migrations/
!packages/api/src/db/migrations/*.sql

# Uploaded media files
uploads/
